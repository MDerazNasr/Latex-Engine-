{
  "name": "@codex-latex/mathjax-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Local MathJax SVG worker for the Codex LaTeX renderer",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@mathjax/src": "4.1.3"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "typescript": "7.0.2"
  }
}
