{
  "name": "@codex-latex/mathjax-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Local MathJax SVG worker for the Codex LaTeX renderer",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --check src test package.json tsconfig.json",
    "format:write": "prettier --write src test package.json tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "mathjax": "4.1.3"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  }
}
